# ================================================================
# Aegis AI — Environment Variables
# Copy this file to .env and fill in your values before running.
# ================================================================

# --- Database ---
LOG_DB_PATH=data/logs/events.db

# --- ChromaDB vector store ---
CHROMA_PERSIST_DIR=data/chroma_db

# --- Self-Healing mode ---
# Options: suggest | semi-auto | auto
FIX_MODE=suggest

# --- API / UI connectivity ---
# URL the Streamlit dashboard uses to reach the FastAPI backend
API_BASE_URL=http://localhost:8000

# --- LLM Provider API Keys ---
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# --- LangChain / LangSmith tracing (optional) ---
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=aegis-ai
