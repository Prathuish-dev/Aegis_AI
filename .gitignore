# =============================================================
# Aegis AI — .gitignore
# =============================================================

# -------------------------------------------------------------
# SECRETS & CREDENTIALS — NEVER commit these
# -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*secret*
*secrets*
*credentials*
*_credentials.json
service_account*.json
gcloud-*.json

# -------------------------------------------------------------
# Python
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments
.venv/
venv/
env/
ENV/
.Python

# Type checking / mypy
.mypy_cache/
.dmypy.json
dmypy.json

# -------------------------------------------------------------
# Testing & Coverage
# -------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.coveragerc
.tox/
nosetests.xml
test-results/

# -------------------------------------------------------------
# Data & Databases
# -------------------------------------------------------------
# SQLite databases (runtime data — not source)
data/logs/*.db
data/logs/
*.db
*.sqlite
*.sqlite3

# ChromaDB vector store (rebuilt on startup)
data/chroma_db/
chroma_db/
*.chroma

# Log files
*.log
logs/

# -------------------------------------------------------------
# IDEs & Editors
# -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# -------------------------------------------------------------
# Docker
# -------------------------------------------------------------
# Don't ignore Dockerfile or docker-compose.yml — those are source
# But do ignore Docker runtime files
.docker/

# -------------------------------------------------------------
# Node / Frontend (if any tooling is added)
# -------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------------------------------------
# OS & Temp files
# -------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
.cache/
tmp/
temp/

# -------------------------------------------------------------
# Build / Distribution artifacts
# -------------------------------------------------------------
*.whl
*.tar.gz
*.zip
site/
docs/_build/
